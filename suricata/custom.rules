# SSN project - application-aware rules (Suricata 8.0.7)
# Old TLS versions (deprecated by RFC 8996)
alert tls any any -> any any (msg:"SSN Old TLS 1.0 negotiated"; flow:established,to_client; tls.version:1.0; classtype:policy-violation; sid:1000001; rev:2;)
alert tls any any -> any any (msg:"SSN Old TLS 1.1 negotiated"; flow:established,to_client; tls.version:1.1; classtype:policy-violation; sid:1000002; rev:2;)
